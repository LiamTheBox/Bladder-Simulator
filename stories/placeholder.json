      "name": "Sam",
      "age": 31,
      "notes": "Project lead. Too polite to interrupt anyone."
    },
    {
      "id": "dana",
      "name": "Dana",
      "age": 44,
      "notes": "Runs the meeting. Loves a slide deck."
    },
    {
      "id": "bladder",
      "name": "Bladder",
      "kind": "bladder"
    }
  ],
  "stats": [
    {
      "id": "control",
      "label": "Control",
